# Template for .env — copy to .env and fill in real values.
# .env is gitignored; this file is tracked.

# PostgreSQL
POSTGRES_USER=mistilteinn
POSTGRES_PASSWORD=change_me_strong_password_here
POSTGRES_DB=mistilteinn

# Backend database URLs — must match POSTGRES_* above
DATABASE_URL=postgresql+asyncpg://mistilteinn:change_me_strong_password_here@db:5432/mistilteinn
TEST_DATABASE_URL=postgresql+asyncpg://mistilteinn:change_me_strong_password_here@db:5432/mistilteinn_test

# Cloudflare Tunnel token (named tunnel only; omit for tunnel-quick profile)
CLOUDFLARE_TUNNEL_TOKEN=
