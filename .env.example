# Template for .env — copy to .env and fill in real values.
# .env is gitignored; this file is tracked.

# ---------------------------------------------------------------------------
# PostgreSQL — EXTERNAL. mistilteinn does not run a database container.
#
# The server is the postgres:16 container owned by the fairy compose stack
# (DESIGN §A3). Both of the databases below, and the role that owns them,
# MUST ALREADY EXIST — nothing in this repo creates them. The exact CREATE
# statements are recorded in the A.6 entry of docs/LOG_mistilteinn.md.
#
#     CREATE ROLE mistilteinn LOGIN PASSWORD '...';
#     CREATE DATABASE mistilteinn      OWNER mistilteinn;
#     CREATE DATABASE mistilteinn_test OWNER mistilteinn;
#
# Host to use:
#   host.docker.internal — from inside compose, via the host-gateway entry in
#                 docker-compose.yml. mistilteinn deliberately does NOT join fairy's
#                 compose network: doing so would register this backend under the
#                 alias `backend` on that network, colliding with fairy's own
#                 `backend` service. See the header of docker-compose.yml.
#   localhost   — running the backend or pytest directly on the host, because
#                 the fairy stack publishes 5432
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://mistilteinn:change_me_strong_password_here@host.docker.internal:5432/mistilteinn
TEST_DATABASE_URL=postgresql+asyncpg://mistilteinn:change_me_strong_password_here@host.docker.internal:5432/mistilteinn_test

# Cloudflare Tunnel token (named tunnel only; omit for tunnel-quick profile)
CLOUDFLARE_TUNNEL_TOKEN=

# ── Production only ──────────────────────────────────────────────────────────
#
# `docker-compose.prod.yml` runs mistilteinn's **own** Postgres, because fairy's prod
# publishes no host port and the dev arrangement above cannot reach it. These three feed
# that service and must agree with the DATABASE_URL you set on the box — where the host is
# `db`, not `host.docker.internal`. See docs/DEPLOY.md §0 and §4.
#
# A.4 removed these when the dev `db` service went away; they are back for prod only, and
# are unused in development.
POSTGRES_USER=mistilteinn
POSTGRES_PASSWORD=change_me_strong_password_here
POSTGRES_DB=mistilteinn
