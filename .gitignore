# Local docker port overrides (per-developer, not shared)
docker-compose.override.yml

# Scratch research files (agent-curation working notes)
scratch_*.txt

# Vendored catalogue art is **not committed** (owner ruling, 2026-11-10; docs/DECISIONS.md).
# It is HoYoverse's, and the repository is going public under AGPLv3, which is not a licence
# we can grant over someone else's art. `cd backend && python -m scripts.download_icons`
# fills this directory locally, and prod's deploy runs the same script into a host directory
# that nginx serves through a bind mount (`docker-compose.prod.yml`). The deploy then probes
# an icon's **content type**: the 2026-08 failure this rule caused last time was nginx's SPA
# fallback answering `200 text/html` for every missing image, and only the type tells a real
# file from the fallback. `tests/unit/test_catalogue_art_is_not_committed.py` pins all three.
frontend/public/icons/

# A user's own GOOD export — their account data, and derivable from the game.
# Kept out of the repo for the same reason icons are: a repository is not a data store,
# and this one is personal.
references/*.json

# Screenshots passed in during review. Ignored for the same reason as the export above and
# then some: two of the first three showed the owner's own inventory, and a screenshot is
# permanent history for a conversation that is not. The *design* references this repo cites
# — `mitya*.png`, and GO's card in `docs/DECISIONS.md` — used to be committed as exceptions.
# They are game art and a screenshot carrying game art, so they left the repo with the icons
# (2026-11-10) and are kept locally only.
references/*.png

# Saved web pages passed in during review — gcsim's results view, and anything like it.
# Same reason as the screenshots above, and then some: "Save page as" drags a site's whole
# vendored bundle in with it (1.8 MB of minified JS, CSS and art the first time), and a
# third-party dump nobody reads is not a reference. Keep the page on disk and cite the URL.
references/*.html
references/*_files/

# Screenshots from `cd backend && python -m scripts.shoot`. Working output, not artefacts.
screenshots/

# Cached dev-only session token for `python -m scripts.shoot`. Never a real credential —
# the account exists only on a local backend — but a token is a token.
.shoot-token
backend/var/
