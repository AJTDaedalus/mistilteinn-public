# ── gcsim's browser wasm ───────────────────────────────────────────────────────
#
# **Built here because it is gitignored, and prod therefore never had it.**
# `frontend/gcsim/{gcsim.wasm,wasm_exec.js}` are 40 MB and deliberately not committed
# (`frontend/gcsim/PROVENANCE.md`). `angular.json` copies them into the bundle *if they
# exist* — an asset glob that matches nothing is not an error — so a prod build produced a
# bundle with no simulator, nginx answered `/gcsim/wasm_exec.js` with the SPA fallback at
# `200 text/html`, and the loader failed with *"could not load gcsim/wasm_exec.js"*.
#
# **"Optimize with rotation" had therefore never worked in production**, and nothing said so:
# the build was green, the deploy was green, the health check passed, and the status code was
# 200. That is the icons incident again (`docs/DECISIONS.md` §4) — four layers each behaving
# correctly, adding up to a dead feature with no symptom, and a status code that could not
# have caught it because only the content-type differs.
#
# The pin is read from `docs/CROSSVAL_gcsim.md`, the one document that owns it, with the same
# expression `scripts/build-gcsim-wasm.sh` uses. It is **not restated here**: two pins that
# can drift apart are two definitions of what "correct" means, and
# `tests/unit/test_gcsim_pin_is_single.py` exists to keep it that way, and covers this file.
#
# Copying only that document keeps the layer's cache key **narrow, not exact**: the key is the
# document's whole content, so a prose edit to it — a tolerance note, a divergence paragraph —
# re-runs the clone and the 40 MB build with the pin unchanged. That is a slow deploy, not a
# wrong one, and it is cheaper than the alternative of extracting the pin into a second file
# that could disagree with the one that owns it.
# **The toolchain has to satisfy gcsim's own `go.mod`, and it did not.** The 2026-08-31 re-pin
# moved to a gcsim that declares `go 1.27.0`; this image was `golang:1.25-alpine` with
# `GOTOOLCHAIN=local`, so the build died with
# `go.mod requires go >= 1.27.0 (running go 1.25.14)` and **three deploys failed in a row**
# while every local gate stayed green — `scripts/ci_local` does not build this image, and the
# host that does had a newer Go than the container.
#
# `tests/unit/test_prod_go_satisfies_the_gcsim_pin.py` compares the two now, so a future re-pin
# fails a test rather than a deploy.
FROM golang:1.27-alpine AS gcsim

RUN apk add --no-cache git grep
WORKDIR /src

COPY docs/CROSSVAL_gcsim.md /pin/CROSSVAL_gcsim.md
RUN set -eux; \
    PIN="$(grep -oP '^\| \*\*Commit\*\* \| `\K[0-9a-f]{40}' /pin/CROSSVAL_gcsim.md)"; \
    [ -n "$PIN" ] || { echo "could not read the gcsim pin from docs/CROSSVAL_gcsim.md" >&2; exit 1; }; \
    git clone --filter=blob:none https://github.com/genshinsim/gcsim .; \
    # The build script fetches the pin explicitly before checking it out, deliberately: a
    # commit reachable from no ref still resolves that way, and without it a gcsim force-push
    # would leave this image unbuildable while the crossval fixtures went on asserting the
    # same SHA.
    git fetch --depth 1 origin "$PIN" 2>/dev/null || git fetch origin; \
    git checkout -q "$PIN"; \
    mkdir -p /out; \
    GOOS=js GOARCH=wasm go build -o /out/gcsim.wasm ./cmd/wasm; \
    # Go moved this between releases — `misc/wasm/` up to 1.23, `lib/wasm/` from 1.24. Check
    # both rather than pinning one, exactly as the build script does.
    EXEC=""; \
    for c in "$(go env GOROOT)/lib/wasm/wasm_exec.js" "$(go env GOROOT)/misc/wasm/wasm_exec.js"; do \
      [ -f "$c" ] && EXEC="$c" && break; \
    done; \
    [ -n "$EXEC" ] || { echo "cannot find wasm_exec.js under $(go env GOROOT)" >&2; exit 1; }; \
    cp "$EXEC" /out/wasm_exec.js; \
    printf '%s\n' "$PIN" > /out/BUILT_FROM; \
    # Both artifacts are redistributed to every visitor and both licences require their
    # notice to travel with them — gcsim's, and Go's for `wasm_exec.js`, which is part of the
    # Go distribution rather than gcsim's source. gcsim's is two files from v2.50.0: the
    # AGPLv3 `LICENSE`, and `LICENSE-MIT` for the code contributed before the relicence.
    cp LICENSE /out/gcsim.LICENSE.txt; \
    cp LICENSE-MIT /out/gcsim-mit.LICENSE.txt; \
    cp "$(go env GOROOT)/LICENSE" /out/go.LICENSE.txt

# ── builder ────────────────────────────────────────────────────────────────────
FROM node:24-alpine AS builder

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./
COPY --from=gcsim /out/ ./gcsim/

RUN npm run build

# **Asserted, not assumed.** An `angular.json` asset glob that matches nothing succeeds
# silently, which is the whole reason this was invisible for as long as it was. A bundle with
# no simulator must not become an image.
RUN set -eu; \
    for f in gcsim/wasm_exec.js gcsim/gcsim.wasm gcsim/gcsim.LICENSE.txt gcsim/gcsim-mit.LICENSE.txt gcsim/go.LICENSE.txt; do \
      [ -s "dist/mistilteinn/browser/$f" ] || { \
        echo "the built bundle has no $f — the simulator would not load in the browser" >&2; \
        exit 1; }; \
    done; \
    echo "bundle carries the simulator: $(du -h dist/mistilteinn/browser/gcsim/gcsim.wasm | cut -f1)"

# **The bundle's own notices, moved into the served tree.** Angular writes
# `3rdpartylicenses.txt` to `dist/mistilteinn/`, one level *above* `browser/` — so the copy
# below, which takes `browser/` alone, left the MIT notices for Angular, RxJS and zone.js
# reaching no visitor at all. That is the same obligation the gcsim notices two lines up
# exist to satisfy, and it went unnoticed because the SPA's catch-all answers every missing
# path with `200 text/html`: the URL "worked" and served the index.
RUN set -eu; \
    [ -s dist/mistilteinn/3rdpartylicenses.txt ] || { \
      echo "the build emitted no 3rdpartylicenses.txt — the bundle's own notices would not ship" >&2; \
      exit 1; }; \
    cp dist/mistilteinn/3rdpartylicenses.txt dist/mistilteinn/browser/3rdpartylicenses.txt; \
    echo "bundle carries its third-party notices: $(wc -c < dist/mistilteinn/browser/3rdpartylicenses.txt) bytes"

# ── runtime ────────────────────────────────────────────────────────────────────
FROM nginx:stable-alpine AS runtime

# Path follows the angular.json project name, renamed fairy -> mistilteinn in A.2.
COPY --from=builder /app/dist/mistilteinn/browser /usr/share/nginx/html
COPY frontend/nginx.prod.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
