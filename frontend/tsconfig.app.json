/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    "types": [
      // WebGPU is not in lib.dom yet. The GPU backend is typed against the real interface
      // rather than `any`, because `any` on a buffer-marshalling layer is exactly where an
      // off-by-one field offset hides — and the shader would read a plausible wrong number.
      "@webgpu/types"
    ]
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts"
  ]
}
