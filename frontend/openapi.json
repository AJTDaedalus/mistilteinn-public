{"type":"null"}],"title":"Weapon Type"}},{"name":"rarity","in":"query","required":false,"schema":{"anyOf":[{"$ref":"#/components/schemas/Rarity"},{"type":"null"}],"title":"Rarity"}},{"name":"name","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Name"}},{"name":"offset","in":"query","required":false,"schema":{"type":"integer","minimum":0,"default":0,"title":"Offset"}},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","maximum":200,"minimum":1,"default":50,"title":"Limit"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PaginatedResponse_WeaponSummary_"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/v1/weapons/{nanoka_id}":{"get":{"tags":["catalogue"],"summary":"Get Weapon","description":"One weapon with its refinement rows and growth curves.","operationId":"get_weapon_api_v1_weapons__nanoka_id__get","parameters":[{"name":"nanoka_id","in":"path","required":true,"schema":{"type":"integer","title":"Nanoka Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WeaponRead"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/v1/artifact-sets":{"get":{"tags":["catalogue"],"summary":"List Artifact Sets","description":"List artifact sets with their bonus affixes.","operationId":"list_artifact_sets_api_v1_artifact_sets_get","parameters":[{"name":"name","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Name"}},{"name":"offset","in":"query","required":false,"schema":{"type":"integer","minimum":0,"default":0,"title":"Offset"}},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","maximum":200,"minimum":1,"default":50,"title":"Limit"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PaginatedResponse_ArtifactSetRead_"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/v1/artifact-sets/{nanoka_id}":{"get":{"tags":["catalogue"],"summary":"Get Artifact Set","description":"One artifact set with its affixes.","operationId":"get_artifact_set_api_v1_artifact_sets__nanoka_id__get","parameters":[{"name":"nanoka_id","in":"path","required":true,"schema":{"type":"integer","title":"Nanoka Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ArtifactSetRead"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/v1/enemies":{"get":{"tags":["catalogue"],"summary":"List Enemies","description":"List enemy profiles.\n\nThe stats in each row are **curve bases**, not level-90 numbers; `stat_curves` names\nthe curve each one grows on. See `EnemyProfileRead`.","operationId":"list_enemies_api_v1_enemies_get","parameters":[{"name":"name","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Name"}},{"name":"offset","in":"query","required":false,"schema":{"type":"integer","minimum":0,"default":0,"title":"Offset"}},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","maximum":200,"minimum":1,"default":50,"title":"Limit"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PaginatedResponse_EnemyProfileRead_"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/v1/enemies/{profile_id}":{"get":{"tags":["catalogue"],"summary":"Get Enemy","description":"One enemy profile by row id.\n\nBy row id, not `nanoka_id`, because `nanoka_id` is **nullable**: a hand-authored\nprofile \u2014 a test dummy, a crossval target \u2014 is a legitimate row that no importer owns\nand would be unreachable through a source-keyed route.","operationId":"get_enemy_api_v1_enemies__profile_id__get","parameters":[{"name":"profile_id","in":"path","required":true,"schema":{"type":"string","title":"Profile Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/EnemyProfileRead"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/v1/artifacts":{"get":{"tags":["artifacts"],"summary":"List Artifacts","description":"The caller's artifacts, in game slot order \u2014 flower, plume, sands, goblet, circlet.","operationId":"list_artifacts_api_v1_artifacts_get","security":[{"HTTPBearer":[]}],"parameters":[{"name":"slot","in":"query","required":false,"schema":{"anyOf":[{"$ref":"#/components/schemas/ArtifactSlot"},{"type":"null"}],"title":"Slot"}},{"name":"set_id","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Set Id"}},{"name":"equipped","in":"query","required":false,"schema":{"anyOf":[{"type":"boolean"},{"type":"null"}],"title":"Equipped"}},{"name":"offset","in":"query","required":false,"schema":{"type":"integer","minimum":0,"default":0,"title":"Offset"}},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","maximum":500,"minimum":1,"default":50,"title":"Limit"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PaginatedResponse_ArtifactRead_"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/v1/artifacts/import/good":{"post":{"tags":["artifacts"],"summary":"Import Good","description":"Import a GOOD export into the caller's inventory.\n\n`mode` is required \u2014 see `GoodImportRequest`. A malformed *envelope* is a 400, because\nthe file is not a GOOD export at all and nothing about it can be salvaged. A malformed\n*artifact* is not: it lands in `rejected` and the rest of the inventory imports, because\nsomeone with 800 artifacts and two odd ones wants the 798.\n\nA `replace` that resolved **nothing** is a 409 and deletes nothing \u2014 see\n`ReplaceRefusedError`.","operationId":"import_good_api_v1_artifacts_import_good_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/GoodImportRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/GoodImportResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}},"security":[{"HTTPBearer":[]}]}},"/api/v1/artifacts/{artifact_id}":{"get":{"tags":["artifacts"],"summary":"Get Artifact","description":"One of the caller's artifacts.","operationId":"get_artifact_api_v1_artifacts__artifact_id__get","security":[{"HTTPBearer":[]}],"parameters":[{"name":"artifact_id","in":"path","required":true,"schema":{"type":"string","title":"Artifact Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ArtifactRead"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"delete":{"tags":["artifacts"],"summary":"Delete Artifact","description":"Delete one of the caller's artifacts.\n\n404 rather than 403 for a piece owned by someone else: the repository is scoped, so a\nforeign id is indistinguishable from a missing one here \u2014 and telling a caller which of\nthe two it was would confirm that some other user owns that id.","operationId":"delete_artifact_api_v1_artifacts__artifact_id__delete","security":[{"HTTPBearer":[]}],"parameters":[{"name":"artifact_id","in":"path","required":true,"schema":{"type":"string","title":"Artifact Id"}}],"responses":{"204":{"description":"Successful Response"},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}}},"components":{"schemas":{"ArtifactRead":{"properties":{"id":{"type":"string","title":"Id"},"slot":{"type":"string","title":"Slot"},"rarity":{"type":"string","title":"Rarity"},"level":{"type":"integer","title":"Level"},"main_stat_type":{"type":"string","title":"Main Stat Type"},"main_stat_value":{"type":"number","title":"Main Stat Value"},"substats":{"items":{},"type":"array","title":"Substats","default":[]},"artifact_set_id":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Artifact Set Id"},"build_id":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Build Id"}},"type":"object","required":["id","slot","rarity","level","main_stat_type","main_stat_value"],"title":"ArtifactRead","description":"One owned artifact."},"ArtifactSetAffixRead":{"properties":{"position":{"type":"integer","title":"Position"},"pieces_required":{"type":"integer","title":"Pieces Required"},"name":{"type":"string","title":"Name"},"description":{"type":"string","title":"Description"},"add_props":{"items":{},"type":"array","title":"Add Props","default":[]},"param_list":{"items":{},"type":"array","title":"Param List","default":[]}},"type":"object","required":["position","pieces_required","name","description"],"title":"ArtifactSetAffixRead","description":"One set-bonus row."},"ArtifactSetRead":{"properties":{"id":{"type":"string","title":"Id"},"nanoka_id":{"type":"integer","title":"Nanoka Id"},"name":{"type":"string","title":"Name"},"icon":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Icon"},"piece_thresholds":{"items":{},"type":"array","title":"Piece Thresholds","default":[]},"available_ranks":{"items":{},"type":"array","title":"Available Ranks","default":[]},"affixes":{"items":{"$ref":"#/components/schemas/ArtifactSetAffixRead"},"type":"array","title":"Affixes","default":[]}},"type":"object","required":["id","nanoka_id","name"],"title":"ArtifactSetRead","description":"One artifact set and its affixes.\n\n`piece_thresholds` is **data**, not the constant `[2, 4]`: 60 of the 65 sets at 7.0.51\nare `[2, 4]` and five are `[1]` \u2014 the \"Prayers\" circlets. A client hardcoding 2pc/4pc\ngets those five wrong, which is why the field is on the summary and not buried."},"ArtifactSlot":{"type":"string","enum":["equip_bracer","equip_necklace","equip_shoes","equip_ring","equip_dress"],"title":"ArtifactSlot","description":"The five artifact slots, keyed by the source's internal names.\n\nSource: the `parts` keys of an artifact *detail* payload\n(`gi/7.0.51/en/artifact/15025.json`, committed under `tests/fixtures/nanoka_gi/detail/`).\n\nA `StrEnum` and not an `IntEnum`, per DESIGN \u00a73: Genshin's slots are named rather than\nordered, and the fixed-main-stat property of flower and plume belongs in a\nslot-to-allowed-mains table (C.5), not in the ordering of an enum.\n\nMember names are the community/display terms; **values are the payload's keys**, which\nis what the importer matches on."},"AscensionPassiveRead":{"properties":{"nanoka_id":{"type":"integer","title":"Nanoka Id"},"unlock_ascension":{"anyOf":[{"type":"integer"},{"type":"null"}],"title":"Unlock Ascension"},"unlock_condition_ids":{"items":{},"type":"array","title":"Unlock Condition Ids","default":[]},"name":{"type":"string","title":"Name"},"description":{"type":"string","title":"Description"},"icon":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Icon"}},"type":"object","required":["nanoka_id","name","description"],"title":"AscensionPassiveRead","description":"One ascension passive.\n\n`unlock_ascension` is **nullable and stays that way**: a passive gated by a condition\nrather than a phase has no phase, and a `0` there would claim it is ungated."},"CharacterRead":{"properties":{"id":{"type":"string","title":"Id"},"nanoka_id":{"type":"string","title":"Nanoka Id"},"name":{"type":"string","title":"Name"},"element":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Element"},"weapon_type":{"type":"string","title":"Weapon Type"},"rarity":{"type":"string","title":"Rarity"},"region":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Region"},"icon":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Icon"},"base_hp":{"type":"number","title":"Base Hp"},"base_atk":{"type":"number","title":"Base Atk"},"base_def":{"type":"number","title":"Base Def"},"base_elemental_mastery":{"type":"number","title":"Base Elemental Mastery"},"base_crit_rate":{"type":"number","title":"Base Crit Rate"},"base_crit_dmg":{"type":"number","title":"Base Crit Dmg"},"prop_curves":{"additionalProperties":true,"type":"object","title":"Prop Curves","default":{}},"ascension_stat_type":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Ascension Stat Type"},"ascension_stats":{"items":{},"type":"array","title":"Ascension Stats","default":[]},"burst_energy_cost":{"anyOf":[{"type":"integer"},{"type":"null"}],"title":"Burst Energy Cost"},"release_date":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Release Date"},"talents":{"items":{"$ref":"#/components/schemas/TalentRead"},"type":"array","title":"Talents","default":[]},"constellations":{"items":{"$ref":"#/components/schemas/ConstellationRead"},"type":"array","title":"Constellations","default":[]},"ascension_passives":{"items":{"$ref":"#/components/schemas/AscensionPassiveRead"},"type":"array","title":"Ascension Passives","default":[]}},"type":"object","required":["id","nanoka_id","name","weapon_type","rarity","base_hp","base_atk","base_def","base_elemental_mastery","base_crit_rate","base_crit_dmg"],"title":"CharacterRead","description":"A character in full: base stats, curves, ascension table, and the kit rows."},"CharacterSummary":{"properties":{"id":{"type":"string","title":"Id"},"nanoka_id":{"type":"string","title":"Nanoka Id"},"name":{"type":"string","title":"Name"},"element":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Element"},"weapon_type":{"type":"string","title":"Weapon Type"},"rarity":{"type":"string","title":"Rarity"},"region":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Region"},"icon":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Icon"}},"type":"object","required":["id","nanoka_id","name","weapon_type","rarity"],"title":"CharacterSummary","description":"A character as a list entry."},"ConstellationRead":{"properties":{"nanoka_id":{"type":"integer","title":"Nanoka Id"},"position":{"type":"integer","title":"Position"},"name":{"type":"string","title":"Name"},"description":{"type":"string","title":"Description"},"icon":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Icon"}},"type":"object","required":["nanoka_id","position","name","description"],"title":"ConstellationRead","description":"One constellation."},"Element":{"type":"string","enum":["Anemo","Cryo","Dendro","Electro","Geo","Hydro","Pyro"],"title":"Element","description":"The seven visions.\n\nSource: distinct `element` values in `gi/7.0.51/character.json` \u2014 `Anemo`, `Cryo`,\n`Dendro`, `Electro`, `Geo`, `Hydro`, `Pyro`, plus a literal `\"None\"` carried by two\ncharacters (the Traveler entries), which is **handled by `parse`, not mapped**.\n\n**Physical is deliberately absent.** It is a damage type, not a vision; modelling it as\na peer of the seven is the ZZZ-shaped trap DESIGN \u00a72.6 calls out by name. See\n`DamageType`."},"EnemyProfileRead":{"properties":{"id":{"type":"string","title":"Id"},"nanoka_id":{"anyOf":[{"type":"integer"},{"type":"null"}],"title":"Nanoka Id"},"name":{"type":"string","title":"Name"},"level":{"type":"integer","title":"Level"},"base_hp":{"type":"number","title":"Base Hp"},"base_atk":{"type":"number","title":"Base Atk"},"base_def":{"type":"number","title":"Base Def"},"stat_curves":{"additionalProperties":true,"type":"object","title":"Stat Curves","default":{}},"physical_res":{"type":"number","title":"Physical Res"},"anemo_res":{"type":"number","title":"Anemo Res"},"cryo_res":{"type":"number","title":"Cryo Res"},"dendro_res":{"type":"number","title":"Dendro Res"},"electro_res":{"type":"number","title":"Electro Res"},"geo_res":{"type":"number","title":"Geo Res"},"hydro_res":{"type":"number","title":"Hydro Res"},"pyro_res":{"type":"number","title":"Pyro Res"},"tags":{"type":"string","title":"Tags","default":""},"variant_nanoka_id":{"anyOf":[{"type":"integer"},{"type":"null"}],"title":"Variant Nanoka Id"},"variant_count":{"type":"integer","title":"Variant Count","default":0}},"type":"object","required":["id","name","level","base_hp","base_atk","base_def","physical_res","anemo_res","cryo_res","dendro_res","electro_res","geo_res","hydro_res","pyro_res"],"title":"EnemyProfileRead","description":"One enemy profile.\n\n**`base_hp` / `base_atk` / `base_def` are curve bases, not level-90 stats.** A\nHilichurl's `base_hp` is `13.584`. The number a damage calculation needs is that base\nscaled by the growth curve named in `stat_curves` at `level`. Anything that multiplies\nthese by a crit multiplier and calls the result damage is wrong, so `stat_curves` ships\nwith them and the field names keep the word \"base\".\n\n`level` describes what the profile is *for*; it is not a level these stats have been\nevaluated at."},"GoodImportRequest":{"properties":{"mode":{"type":"string","enum":["replace","append"],"title":"Mode"},"payload":{"additionalProperties":true,"type":"object","title":"Payload","description":"A GOOD export, as exported."}},"type":"object","required":["mode","payload"],"title":"GoodImportRequest","description":"Body for `POST /artifacts/import/good`.\n\n`mode` has **no default**, and that is the point. GOOD carries no stable per-artifact\nidentifier, so `append` run twice duplicates a whole inventory \u2014 and a duplicated goblet\nis not clutter, it is a search that will happily recommend wearing the same piece twice.\n`replace` deletes. Neither is safe to reach by omission, so the request states which."},"GoodImportResponse":{"properties":{"inserted":{"type":"integer","title":"Inserted"},"deleted":{"type":"integer","title":"Deleted"},"rejected":{"items":{"$ref":"#/components/schemas/ImportRejection"},"type":"array","title":"Rejected","default":[]},"ok":{"type":"boolean","title":"Ok"},"source":{"type":"string","title":"Source","default":""},"version":{"type":"integer","title":"Version","default":0}},"type":"object","required":["inserted","deleted","ok"],"title":"GoodImportResponse","description":"What the import did.\n\n`rejected` lists both the artifacts the parser refused and the ones whose set this\ndatabase does not know. A caller showing a user what happened should not have to tell\nthose apart, and a partial import that reported only a count would be the thing this\nimporter exists not to be."},"HTTPValidationError":{"properties":{"detail":{"items":{"$ref":"#/components/schemas/ValidationError"},"type":"array","title":"Detail"}},"type":"object","title":"HTTPValidationError"},"ImportRejection":{"properties":{"index":{"type":"integer","title":"Index"},"reason":{"type":"string","title":"Reason"}},"type":"object","required":["index","reason"],"title":"ImportRejection","description":"One artifact that did not make it in, and why."},"LoginRequest":{"properties":{"email":{"type":"string","format":"email","title":"Email"},"password":{"type":"string","maxLength":72,"minLength":12,"title":"Password"}},"type":"object","required":["email","password"],"title":"LoginRequest","description":"Body for `POST /auth/login`."},"LoginResponse":{"properties":{"token":{"type":"string","title":"Token"},"expires_at":{"type":"string","format":"date-time","title":"Expires At"}},"type":"object","required":["token","expires_at"],"title":"LoginResp